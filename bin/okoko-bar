#!/usr/bin/env bash
# okoko-bar - workspace buttons, VPN and target values for the bar (i3blocks.conf), tmux and
# the prompt.
set -uo pipefail
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/okoko"

vpn_ip() {
    local ip
    for i in tun0 tun1 wg0 ppp0; do
        ip=$(ip -4 -o addr show "$i" 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
        [[ -n $ip ]] && { printf '%s\n' "$ip"; return; }
    done
    return 1
}

case "${1:-}" in
    vpn)
        if ip=$(vpn_ip); then
            [[ "${2:-}" == --copy ]] && { printf '%s' "$ip" | xclip -selection clipboard; notify-send "okoko" "VPN IP copied: $ip" 2>/dev/null; exit; }
            [[ "${2:-}" == --plain ]] && { printf '%s\n' "$ip"; exit; }
            printf '%s\n' "$ip"
        else
            [[ "${2:-}" == --plain ]] && exit 0
            printf 'down\n'
        fi
        ;;
    target)
        t=$(cat "$STATE/target" 2>/dev/null)
        [[ -z $t ]] && { [[ "${2:-}" == --plain ]] && exit 0; printf 'no target\n'; exit; }
        [[ "${2:-}" == --copy ]] && { printf '%s' "$t" | xclip -selection clipboard; notify-send "okoko" "target copied: $t" 2>/dev/null; exit; }
        printf '%s\n' "$t"
        ;;
    ws)
        # one workspace button for i3blocks (format=json); $button is set on click.
        # Only a number is printed, never a window name: nothing can inject bar markup.
        n="${2:-}"; [[ $n =~ ^([1-9]|10)$ ]] || exit 0
        [[ ${button:-} == 1 ]] && i3-msg -q "workspace number $n"
        obj=$(i3-msg -t get_workspaces 2>/dev/null | sed 's/"rect":{[^}]*}//g' | tr '{' '\n' | grep -m1 "\"num\":$n,")
        if [[ -z $obj ]]; then
            (( n <= 4 )) || exit 0
            fg="#888888" bg="#1C1D2B" bd="#1C1D2B"                   # empty, kept on the bar
        elif [[ $obj == *'"urgent":true'* ]]; then fg="#FFFFFF" bg="#900000" bd="#900000"
        elif [[ $obj == *'"focused":true'* ]]; then fg="#FFFFFF" bg="#282A3E" bd="#82C8FF"
        else fg="#E6FFF5" bg="#1C1D2B" bd="#333333"; fi              # holds windows
        printf '{"full_text":" %s ","color":"%s","background":"%s","border":"%s","separator_block_width":4}\n' "$n" "$fg" "$bg" "$bd"
        ;;
    *) echo "usage: okoko-bar {vpn|target} [--copy|--plain] | ws N" >&2; exit 1 ;;
esac
