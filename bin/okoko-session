#!/usr/bin/env bash
# okoko-session - idempotent autostart, safe to run on every i3 (re)start.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/okoko"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$STATE"

# run a single instance of a long-running daemon
# (the kernel truncates process names to 15 chars, so match on that: "xfce4-screensav")
once() { local name="$1"; shift; pgrep -x "${name:0:15}" >/dev/null || "$@" & }

# 1. make sure a theme has been rendered at least once
[[ -f "$CONF/okoko/current/colors.sh" ]] || okoko theme "$(cat "$STATE/theme" 2>/dev/null || echo okoko)" --no-reload

# 2. compositor - backend chosen by hardware
backend=xrender
if command -v glxinfo >/dev/null && [[ -n "${DISPLAY:-}" ]]; then
    r=$(timeout 3 glxinfo -B 2>/dev/null | awk -F': ' '/OpenGL renderer/{print $2}')
    case "$r" in ""|*llvmpipe*|*softpipe*|*SVGA3D*|*virgl*) backend=xrender ;; *) backend=glx ;; esac
fi
# wait for the old compositor to exit: two picom fighting over the screen = glitches
pkill -x picom 2>/dev/null
for _ in $(seq 1 30); do pgrep -x picom >/dev/null || break; sleep 0.1; done
pkill -9 -x picom 2>/dev/null
picom --backend "$backend" --config "$CONF/picom/picom.conf" & disown

# 3. wallpaper, notifications, clipboard, terminal
okoko-wall restore >/dev/null 2>&1 &   # first run renders the theme set (a few seconds)
once dunst dunst
# clipboard history (CopyQ, hidden) for okoko-clip / Super+Ctrl+V
command -v copyq >/dev/null && { okoko-clip setup >/dev/null 2>&1 & disown; }
# rofi reads apps from its desktop cache: rebuild it once per session so new apps show up
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/rofi-drun-desktop.cache"
# Thunar opens in ~0.85 s cold; its daemon keeps it ready (single instance)
command -v thunar >/dev/null && once thunar thunar --daemon
# terminal colors/font: xfce4-terminal reads them from xfconf, which needs the session bus
sh "$CONF/okoko/current/xfce4-terminal.sh" >/dev/null 2>&1 &
# the bar is i3bar + i3blocks (i3 starts it); stop the polybar of older okoko versions
pkill -f 'okoko-bar watch' 2>/dev/null; pkill -x polybar 2>/dev/null

# 4. VM guest integration (clipboard / resolution)
if systemd-detect-virt --vm --quiet 2>/dev/null; then
    once spice-vdagent spice-vdagent
    command -v vmware-user-suid-wrapper >/dev/null && vmware-user-suid-wrapper &
fi

# 5. misc one-shots
# Kali packages the classic unclutter (8-x): single-dash options
once unclutter unclutter -idle 3 -jitter 20
# screen lock: Kali's default (xfce4-screensaver: idle lock + xflock4). i3 does not run XDG
# autostart, so start it here. Stop the xss-lock/i3lock pair older okoko versions started.
pkill -x xss-lock 2>/dev/null
command -v xfce4-screensaver >/dev/null && once xfce4-screensaver xfce4-screensaver
command -v nm-applet >/dev/null && once nm-applet nm-applet --indicator
exit 0
