#!/usr/bin/env bash
# okoko-lock — themed lock screen (i3lock-color if present, else i3lock).
set -uo pipefail
source "${XDG_CONFIG_HOME:-$HOME/.config}/okoko/current/colors.sh" 2>/dev/null
hex() { printf '%s' "${1#\#}"; }
if command -v i3lock-color >/dev/null || i3lock --version 2>&1 | grep -qi color; then
    exec i3lock \
        --ignore-empty-password --show-failed-attempts \
        --color="$(hex "${BG:-#091413}")" \
        --inside-color="$(hex "${BG_ALT:-#0F1F1C}")ee" \
        --ring-color="$(hex "${ACCENT:-#408A71}")ff" \
        --insidever-color="$(hex "${SURFACE:-#285A48}")ee" \
        --ringver-color="$(hex "${ACCENT2:-#5FD38D}")ff" \
        --insidewrong-color="$(hex "${URGENT:-#E0607E}")ee" \
        --ringwrong-color="$(hex "${URGENT:-#E0607E}")ff" \
        --line-uses-inside --keyhl-color="$(hex "${ACCENT2:-#5FD38D}")ff" \
        --separator-color=00000000 --clock --indicator \
        --time-color="$(hex "${FG:-#B0E4CC}")ff" --date-color="$(hex "${MUTED:-#6E9A8A}")ff" \
        --verif-color="$(hex "${FG}")ff" --wrong-color="$(hex "${URGENT}")ff" \
        --radius=120 --ring-width=8
else
    exec i3lock -c "$(hex "${BG:-#091413}")"
fi
