// okoko - fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  ", "color": { "keys": "green" } },
  "modules": [
    "title",
    { "type": "custom", "format": "okoko - i3 rice for offensive VMs" },
    "break",
    { "type": "os", "key": " os" },
    { "type": "kernel", "key": " kernel" },
    { "type": "host", "key": " host" },
    { "type": "wm", "key": " wm" },
    { "type": "terminal", "key": " term" },
    { "type": "shell", "key": " shell" },
    { "type": "cpu", "key": " cpu" },
    { "type": "memory", "key": " mem" },
    { "type": "disk", "key": " disk", "folders": "/" },
    { "type": "localip", "key": "󰖂 ip", "showIpv6": false },
    "break",
    "colors"
  ]
}
